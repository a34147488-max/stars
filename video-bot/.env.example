BOT_TOKEN=123456:replace_with_bot_token
FAL_KEY=replace_with_fal_api_key
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Your Telegram numeric user ID(s), comma-separated. Never use a username here.
ADMIN_IDS=123456789
FREE_LIMIT=3
# Optional: model defaults to minimax/h3-max/text-to-video
FAL_MODEL=minimax/h3-max/text-to-video
FAL_IMAGE_MODEL=minimax/h3-max/image-to-video
# 480P is the lower-cost setting. Available values: 480P, 768P, 1080P
VIDEO_RESOLUTION=480P
# Optional polling interval in milliseconds
POLL_MS=7000
# If your external Postgres requires TLS, set to require
# PGSSLMODE=require
